---
import Layout from "../../../layouts/Layout.astro";
import movies from "../../../assets/movies.json";

// Détermination automatique des genres
const genresList = [...new Set(movies.map((m) => m.genre))].sort();
---

<Layout title="Films par Genre • SSG getStaticPaths">
  <div class="space-y-6 max-w-5xl mx-auto">
    <div class="bg-white/80 backdrop-blur-sm border border-sky-100 p-6 rounded-2xl shadow-xs">
      <div class="inline-block px-2.5 py-0.5 bg-rose-100 text-rose-800 text-xs font-semibold rounded-md mb-1 border border-rose-200">
        Dataset Cinéma • Routes SSG
      </div>
      <h1 class="text-2xl font-bold text-slate-800">Films par Genre</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        Liste générée automatiquement via <code>[...new Set(movies.map(m =&gt; m.genre))]</code>.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {
        genresList.map((genre) => {
          const count = movies.filter((m) => m.genre === genre).length;
          return (
            <a
              href={`/movies/genre/${genre}`}
              class="card bg-white/90 border border-sky-100 hover:border-rose-300 hover:shadow-md transition p-5 rounded-2xl group"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="w-9 h-9 rounded-xl bg-pink-100 text-rose-700 flex items-center justify-center font-bold text-base">
                  🎬
                </span>
                <span class="badge badge-soft bg-sky-100 text-sky-700 text-xs">
                  {count} films
                </span>
              </div>
              <h2 class="text-base font-bold text-slate-800 group-hover:text-rose-600 transition">
                {genre}
              </h2>
              <p class="text-xs text-slate-500 mt-1">
                Visualiser les films du genre {genre} générés avec <code>getStaticPaths</code>.
              </p>
            </a>
          );
        })
      }
    </div>
  </div>
</Layout>

