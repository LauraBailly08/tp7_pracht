---
import Layout from "../../layouts/Layout.astro";
import penguins from "../../assets/penguins.json";
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";

// Détermination automatique de la liste des espèces uniques
const speciesList = [...new Set(penguins.map((p) => p.species))].sort();

// Préparation des graphiques pour chaque espèce via une boucle / map
const speciesPlots = speciesList.map((species) => {
  const filtered = penguins.filter((p) => p.species === species);
  const options = {
    title: `Manchots - Espèce ${species}`,
    subtitle: `${filtered.length} individus`,
    grid: true,
    color: {
      domain: ["Adelie", "Chinstrap", "Gentoo"],
    },
    x: {
      label: "Longueur du bec (mm) →",
      domain: [30, 60],
    },
    y: {
      label: "↑ Profondeur du bec (mm)",
      domain: [12, 23],
    },
    marks: [
      Plot.dot(filtered, {
        x: "culmen_length_mm",
        y: "culmen_depth_mm",
        stroke: "species",
        fill: "species",
        fillOpacity: 0.35,
        r: 6,
        tip: true,
      }),
    ],
  };
  return { species, count: filtered.length, options };
});
---

<Layout title="Manchots - Tous les graphiques par Onglets">
  <div class="space-y-6 max-w-5xl mx-auto">
    <div class="bg-white/80 backdrop-blur-sm border border-sky-100 p-6 rounded-2xl shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <div class="inline-block px-2.5 py-0.5 bg-sky-100 text-sky-800 text-xs font-semibold rounded-md mb-1 border border-sky-200">
          TP • Boucle & Onglets
        </div>
        <h1 class="text-2xl font-bold text-slate-800">Graphiques de tous les Manchots</h1>
        <p class="text-xs sm:text-sm text-slate-500">
          Génération dynamique des graphiques par espèce avec boucle <code>map</code> et <code>[...new Set()]</code>.
        </p>
      </div>

      <div class="flex gap-2">
        <a href="/penguins/specie" class="btn btn-xs bg-sky-100 text-sky-800 border-sky-200 hover:bg-sky-200 rounded-lg">
          Par Espèce →
        </a>
        <a href="/penguins/island" class="btn btn-xs bg-pink-100 text-rose-800 border-pink-200 hover:bg-pink-200 rounded-lg">
          Par Île →
        </a>
        <a href="/penguins/sex" class="btn btn-xs bg-purple-100 text-purple-800 border-purple-200 hover:bg-purple-200 rounded-lg">
          Par Sexe →
        </a>
      </div>
    </div>

    <!-- Interface par Onglets DaisyUI -->
    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-6">
      <div role="tablist" class="tabs tabs-box bg-slate-50 p-1.5 rounded-xl border border-sky-100 mb-6">
        {
          speciesPlots.map(({ species, count }, index) => (
            <input
              type="radio"
              name="penguin_tabs"
              role="tab"
              class="tab text-xs font-bold text-slate-700 checked:bg-white checked:shadow-xs checked:text-rose-600 rounded-lg"
              aria-label={`Espèce ${species} (${count})`}
              checked={index === 0}
            />
            <div role="tabpanel" class="tab-content bg-white border-t border-sky-100 p-4 mt-4 rounded-xl">
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
                  Espèce : {species}
                </h3>
                <span class="badge badge-soft bg-sky-100 text-sky-800 text-xs font-medium">
                  {count} spécimens
                </span>
              </div>
              <div class="bg-sky-50/40 p-4 rounded-xl flex justify-center items-center overflow-x-auto min-h-[350px]">
                <PlotFigure options={speciesPlots[index].options} />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Vue en Grille comparative de toutes les espèces -->
    <div class="space-y-4">
      <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
        Vue comparative simultanée (Toutes les espèces)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          speciesPlots.map(({ species, count, options }) => (
            <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-4">
              <div class="flex justify-between items-center mb-2">
                <h4 class="text-sm font-bold text-slate-800">{species}</h4>
                <span class="text-xs text-slate-500">{count} manchots</span>
              </div>
              <div class="bg-sky-50/30 p-2 rounded-lg flex justify-center items-center overflow-x-auto min-h-[220px]">
                <PlotFigure options={{ ...options, width: 280, height: 200 }} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

