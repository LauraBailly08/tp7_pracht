---
import Layout from "../../../layouts/Layout.astro";
import penguins from "../../../assets/penguins.json";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";

// Génération statique des chemins (SSG)
export async function getStaticPaths() {
  const speciesList = [...new Set(penguins.map((p) => p.species))];
  return speciesList.map((species) => ({
    params: { species },
    props: {
      species,
      filteredPenguins: penguins.filter((p) => p.species === species),
      allSpecies: speciesList.sort(),
    },
  }));
}

const { species } = Astro.params;
const { filteredPenguins, allSpecies } = Astro.props;

// Configuration du graphique Plot
const plotOptions = {
  title: `Dimensions du bec - Espèce ${species}`,
  subtitle: `${filteredPenguins.length} manchots enregistrés`,
  grid: true,
  color: {
    domain: ["Adelie", "Chinstrap", "Gentoo"],
  },
  x: {
    label: "Longueur du bec (mm) →",
    domain: [30, 60],
  },
  y: {
    label: "↑ Profondeur du bec (mm)",
    domain: [12, 23],
  },
  marks: [
    Plot.dot(filteredPenguins, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      stroke: "species",
      fill: "species",
      fillOpacity: 0.4,
      r: 6,
      tip: true,
    }),
  ],
};
---

<Layout title={`Manchot ${species} • SSG getStaticPaths`}>
  <div class="space-y-6 max-w-5xl mx-auto">
    <div class="bg-white/80 backdrop-blur-sm border border-sky-100 p-6 rounded-2xl shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <a href="/penguins/specie" class="text-xs font-semibold text-sky-600 hover:text-rose-600 flex items-center gap-1 mb-1 transition">
          ← Retour aux espèces
        </a>
        <h1 class="text-2xl font-bold text-slate-800">Espèce : {species}</h1>
        <p class="text-xs sm:text-sm text-slate-500">
          Page pré-générée statiquement avec <code>getStaticPaths()</code>.
        </p>
      </div>
      <div class="badge badge-soft bg-sky-100 text-sky-800 border-sky-200 text-xs font-medium px-3 py-2">
        {filteredPenguins.length} individus
      </div>
    </div>

    <!-- Navigation rapide entre espèces -->
    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-4 flex flex-row flex-wrap items-center gap-2">
      <span class="text-xs font-semibold text-slate-600 mr-2">Changer d'espèce :</span>
      {
        allSpecies.map((sp) => (
          <a
            href={`/penguins/specie/${sp}`}
            class={`btn btn-xs rounded-lg ${sp === species ? "bg-rose-500 text-white" : "bg-slate-50 text-slate-600 hover:bg-sky-50"}`}
          >
            {sp}
          </a>
        ))
      }
    </div>

    <!-- Graphique PlotFigure -->
    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-6 space-y-3">
      <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
        Nuage de points : {species}
      </h2>
      <div class="bg-sky-50/40 p-4 rounded-xl flex justify-center items-center overflow-x-auto min-h-[350px]">
        <PlotFigure options={plotOptions} />
      </div>
    </div>
  </div>
</Layout>

