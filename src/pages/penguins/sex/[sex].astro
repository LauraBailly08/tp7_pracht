---
import Layout from "../../../layouts/Layout.astro";
import penguins from "../../../assets/penguins.json";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";

// Génération statique des chemins (SSG)
export async function getStaticPaths() {
  const sexList = [...new Set(penguins.map((p) => p.sex?.trim()).filter(Boolean))];
  return sexList.map((sex) => ({
    params: { sex },
    props: {
      sex,
      filteredPenguins: penguins.filter((p) => p.sex?.trim() === sex),
      allSexes: sexList.sort(),
    },
  }));
}

const { sex } = Astro.params;
const { filteredPenguins, allSexes } = Astro.props;

// Configuration du graphique Plot
const plotOptions = {
  title: `Biométrie des manchots de sexe ${sex}`,
  subtitle: `${filteredPenguins.length} individus enregistrés`,
  grid: true,
  color: {
    legend: true,
    domain: ["Adelie", "Chinstrap", "Gentoo"],
  },
  x: {
    label: "Longueur des nageoires (mm) →",
  },
  y: {
    label: "↑ Masse corporelle (g)",
  },
  marks: [
    Plot.dot(filteredPenguins, {
      x: "flipper_length_mm",
      y: "body_mass_g",
      stroke: "species",
      fill: "species",
      fillOpacity: 0.4,
      r: 6,
      tip: true,
    }),
  ],
};
---

<Layout title={`Manchots (${sex}) • SSG getStaticPaths`}>
  <div class="space-y-6 max-w-5xl mx-auto">
    <div class="bg-white/80 backdrop-blur-sm border border-purple-100 p-6 rounded-2xl shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <a href="/penguins/sex" class="text-xs font-semibold text-purple-600 hover:text-rose-600 flex items-center gap-1 mb-1 transition">
          ← Retour aux sexes
        </a>
        <h1 class="text-2xl font-bold text-slate-800">Sexe : {sex === "MALE" ? "Mâle (MALE)" : "Femelle (FEMALE)"}</h1>
        <p class="text-xs sm:text-sm text-slate-500">
          Page pré-rendue statiquement avec <code>getStaticPaths()</code>.
        </p>
      </div>
      <div class="badge badge-soft bg-purple-100 text-purple-800 border-purple-200 text-xs font-medium px-3 py-2">
        {filteredPenguins.length} individus
      </div>
    </div>

    <!-- Navigation rapide entre sexes -->
    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-4 flex flex-row flex-wrap items-center gap-2">
      <span class="text-xs font-semibold text-slate-600 mr-2">Changer de sexe :</span>
      {
        allSexes.map((s) => (
          <a
            href={`/penguins/sex/${s}`}
            class={`btn btn-xs rounded-lg ${s === sex ? "bg-purple-600 text-white" : "bg-slate-50 text-slate-600 hover:bg-purple-50"}`}
          >
            {s}
          </a>
        ))
      }
    </div>

    <!-- Graphique PlotFigure -->
    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-6 space-y-3">
      <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span>
        Longueur de nageoire vs Masse corporelle ({sex})
      </h2>
      <div class="bg-purple-50/20 p-4 rounded-xl flex justify-center items-center overflow-x-auto min-h-[350px]">
        <PlotFigure options={plotOptions} />
      </div>
    </div>
  </div>
</Layout>
