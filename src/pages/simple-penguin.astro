---
import Layout from "../layouts/Layout.astro";
---

<Layout title="2. Simple Penguin • TP4">
  <div class="space-y-6 max-w-5xl mx-auto">
    <div class="bg-white/80 backdrop-blur-sm border border-sky-100 p-6 rounded-2xl shadow-xs">
      <div class="inline-block px-2.5 py-0.5 bg-sky-100 text-sky-800 text-xs font-semibold rounded-md mb-1 border border-sky-200">
        Etape 2
      </div>
      <h1 class="text-2xl font-bold text-slate-800">Simple Penguin (Client-side)</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        Affichage du nuage de points des manchots genere cote client a partir de <code>penguins.json</code>.
      </p>
    </div>

    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-6 space-y-3">
      <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
        Nuage de points : Longueur vs Profondeur du Bec
      </h2>
      <div id="penguin-plot" class="flex justify-center p-4 bg-sky-50/40 rounded-xl overflow-x-auto min-h-[360px] items-center"></div>
    </div>
  </div>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import penguins from "../assets/penguins.json";

  const plot = Plot.plot({
    title: "Dimensions du bec selon l'espece de manchot",
    grid: true,
    color: {
      legend: true,
    },
    x: {
      label: "Longueur du bec (mm) ->",
    },
    y: {
      label: "^ Profondeur du bec (mm)",
    },
    marks: [
      Plot.dot(penguins, {
        x: "culmen_length_mm",
        y: "culmen_depth_mm",
        stroke: "species",
        tip: true,
      }),
    ],
  });

  const div = document.querySelector("#penguin-plot");
  div?.append(plot);
</script>
