---
import Layout from "../layouts/Layout.astro";
---

<Layout title="1. Simple • TP4">
  <div class="space-y-6 max-w-5xl mx-auto">
    <div class="bg-white/80 backdrop-blur-sm border border-sky-100 p-6 rounded-2xl shadow-xs">
      <div class="inline-block px-2.5 py-0.5 bg-sky-100 text-sky-800 text-xs font-semibold rounded-md mb-1 border border-sky-200">
        Etape 1
      </div>
      <h1 class="text-2xl font-bold text-slate-800">Graphique Simple Cote Client</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        Exemple officiel Observable Plot rendu dynamiquement dans le navigateur a l'aide d'un script client.
      </p>
    </div>

    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-6 space-y-3">
      <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
        Histogramme de distribution aleatoire
      </h2>
      <div id="myplot" class="flex justify-center p-4 bg-sky-50/40 rounded-xl overflow-x-auto min-h-[300px] items-center"></div>
    </div>
  </div>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";

  const plot = Plot.rectY(
    { length: 10000 },
    Plot.binX({ y: "count" }, { x: Math.random })
  ).plot({
    title: "Distribution aleatoire (10 000 tirages)",
    x: { label: "Valeur (0 a 1) ->" },
    y: { label: "^ Frequence", grid: true },
    marks: [
      Plot.ruleY([0])
    ]
  });

  const div = document.querySelector("#myplot");
  div?.append(plot);
</script>
