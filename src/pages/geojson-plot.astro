---
import Layout from "../layouts/Layout.astro";
import populationMain from "../assets/populationMain.json";

// Extraction dynamique côté serveur des listes pour les 3 SELECT demandés
const listePeriode = [
  ...new Set(populationMain?.map((d) => d.Période)),
].reverse();

const listeSex = [
  ...new Set(populationMain?.map((d) => d.Sex)),
];

const listeAge = [
  ...new Set(populationMain?.map((d) => d.Age)),
];
---

<Layout title="2) Carte GéoJSON & Observable Plot (Côté Client)">
  <div class="max-w-6xl mx-auto space-y-6 py-2">
    <!-- En-tête -->
    <div class="bg-white/80 backdrop-blur-sm border border-sky-100 p-8 rounded-3xl shadow-xs space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100/80 border border-purple-200 text-xs font-semibold text-purple-800">
        🌍 Partie 2 • Astro GeoJSON & Observable Plot (Exécution Côté Client)
      </div>
      <h1 class="text-3xl font-extrabold text-slate-800">
        Carte Choroplèthe de la Population par Département
      </h1>
      <p class="text-slate-600 text-sm leading-relaxed max-w-3xl">
        Visualisation réactive côté client : sélection interactive de l'<strong>Année (Période)</strong>, du <strong>Sexe</strong> et de la <strong>Tranche d'Âge</strong>. Le fond de carte GeoJSON est joint aux statistiques démographiques pour recalculer la carte en temps réel.
      </p>

      <!-- Barre de Filtres avec les 3 SELECT demandés par le professeur -->
      <div class="pt-4 border-t border-sky-100 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- 1. SELECT Période / Année -->
        <div class="form-control">
          <label for="periode" class="label py-1">
            <span class="label-text font-bold text-xs text-slate-700">📅 Année / Période :</span>
          </label>
          <select id="periode" class="select select-bordered select-sm rounded-xl text-xs bg-white w-full">
            {listePeriode.map((p, i) => <option selected={i === 0}>{p}</option>)}
          </select>
        </div>

        <!-- 2. SELECT Sexe -->
        <div class="form-control">
          <label for="sex" class="label py-1">
            <span class="label-text font-bold text-xs text-slate-700">⚧️ Sexe / Genre :</span>
          </label>
          <select id="sex" class="select select-bordered select-sm rounded-xl text-xs bg-white w-full">
            {listeSex.map((s, i) => <option selected={i === 0}>{s}</option>)}
          </select>
        </div>

        <!-- 3. SELECT Âge -->
        <div class="form-control">
          <label for="age" class="label py-1">
            <span class="label-text font-bold text-xs text-slate-700">🎂 Tranche d'Âge :</span>
          </label>
          <select id="age" class="select select-bordered select-sm rounded-xl text-xs bg-white w-full">
            {listeAge.map((a, i) => <option selected={i === 0}>{a}</option>)}
          </select>
        </div>
      </div>
    </div>

    <!-- Indicateurs Clés -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="stat bg-white/90 border border-sky-100 rounded-2xl shadow-xs p-4">
        <div class="stat-title text-xs text-slate-500">Population Filtrée</div>
        <div class="stat-value text-xl font-extrabold text-sky-700" id="stat-total">-</div>
        <div class="stat-desc text-[11px] text-slate-400">Total France métropolitaine</div>
      </div>

      <div class="stat bg-white/90 border border-sky-100 rounded-2xl shadow-xs p-4">
        <div class="stat-title text-xs text-slate-500">Département Max</div>
        <div class="stat-value text-xl font-extrabold text-rose-600" id="stat-max">-</div>
        <div class="stat-desc text-[11px] text-slate-400" id="stat-max-dep">-</div>
      </div>

      <div class="stat bg-white/90 border border-sky-100 rounded-2xl shadow-xs p-4">
        <div class="stat-title text-xs text-slate-500">Département Min</div>
        <div class="stat-value text-xl font-extrabold text-purple-600" id="stat-min">-</div>
        <div class="stat-desc text-[11px] text-slate-400" id="stat-min-dep">-</div>
      </div>

      <div class="stat bg-white/90 border border-sky-100 rounded-2xl shadow-xs p-4">
        <div class="stat-title text-xs text-slate-500">Moyenne par Dépt.</div>
        <div class="stat-value text-xl font-extrabold text-emerald-600" id="stat-avg">-</div>
        <div class="stat-desc text-[11px] text-slate-400">Sur 96 départements</div>
      </div>
    </div>

    <!-- Conteneur de la Carte Observable Plot -->
    <div class="card bg-white border border-sky-100 shadow-sm rounded-3xl p-4 sm:p-6 space-y-4">
      <div id="plot-chart" class="overflow-x-auto flex justify-center items-center min-h-[500px]">
        <div class="flex flex-col items-center gap-2 text-slate-400 text-xs">
          <span class="loading loading-spinner loading-md"></span>
          Chargement de la carte Observable Plot...
        </div>
      </div>
    </div>

    <!-- Code explicatif côté client & conformité TP -->
    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-6 space-y-3 text-xs text-slate-600">
      <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
        <span>⚙️</span> Fonctionnement Client & Accessibilité Conforme aux Attentes
      </h2>
      <ul class="list-disc list-inside space-y-1">
        <li><strong>Données GeoJSON :</strong> <code>departements.geojson.json</code> projeté avec la projection <code>mercator</code> intégrée à Observable Plot.</li>
        <li><strong>Jointure réactive :</strong> Chaque changement sur <code>#periode</code>, <code>#sex</code> ou <code>#age</code> recalcule les populations par code départemental.</li>
        <li><strong>Accessibilité a11y :</strong> Options <code>title</code>, <code>subtitle</code>, <code>caption</code> et <code>ariaLabel</code> dynamiques sur le conteneur <code>Plot.plot(...)</code>.</li>
        <li><strong>Infobulle interactive :</strong> Survol de chaque département affichant le nom, le code et le nombre précis d'habitants.</li>
      </ul>
    </div>
  </div>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import populationMain from "../assets/populationMain.json";
  import departements from "../assets/departements.geojson.json";

  // Récupération des éléments DOM des 3 SELECT selon le modèle du sujet
  const elmYear = document.getElementById("periode") as HTMLSelectElement;
  const elmSex = document.getElementById("sex") as HTMLSelectElement;
  const elmAge = document.getElementById("age") as HTMLSelectElement;
  const chartContainer = document.getElementById("plot-chart") as HTMLElement;

  // Éléments des statistiques
  const statTotal = document.getElementById("stat-total") as HTMLElement;
  const statMax = document.getElementById("stat-max") as HTMLElement;
  const statMaxDep = document.getElementById("stat-max-dep") as HTMLElement;
  const statMin = document.getElementById("stat-min") as HTMLElement;
  const statMinDep = document.getElementById("stat-min-dep") as HTMLElement;
  const statAvg = document.getElementById("stat-avg") as HTMLElement;

  function updatePlot() {
    if (!elmYear || !elmSex || !elmAge || !chartContainer) return;

    const selectedYear = Number(elmYear.value);
    const selectedSex = elmSex.value;
    const selectedAge = elmAge.value;

    // Filtrage des données
    const filtered = populationMain.filter(
      (d: any) =>
        Number(d.Période) === selectedYear &&
        d.Sex === selectedSex &&
        d.Age === selectedAge
    );

    // Map code département -> valeur
    const popMap = new Map<string, number>();
    let total = 0;
    let minVal = Infinity;
    let minDepName = "";
    let maxVal = -Infinity;
    let maxDepName = "";

    filtered.forEach((d: any) => {
      const code = String(d.dep || d.code || d.Code).padStart(2, "0");
      const val = Number(d.Valeur || d.Population || 0);
      popMap.set(code, val);

      total += val;
      if (val > maxVal) {
        maxVal = val;
        maxDepName = `${d.Géographie || d.nom || code} (${code})`;
      }
      if (val < minVal) {
        minVal = val;
        minDepName = `${d.Géographie || d.nom || code} (${code})`;
      }
    });

    // Mise à jour des cartes statistiques
    if (statTotal) statTotal.textContent = total.toLocaleString("fr-FR") + " hab.";
    if (statMax) statMax.textContent = maxVal.toLocaleString("fr-FR");
    if (statMaxDep) statMaxDep.textContent = maxDepName;
    if (statMin) statMin.textContent = minVal.toLocaleString("fr-FR");
    if (statMinDep) statMinDep.textContent = minDepName;
    if (statAvg) statAvg.textContent = Math.round(total / (filtered.length || 1)).toLocaleString("fr-FR") + " hab.";

    // Construction du Plot avec toutes les options d'accessibilité (a11y)
    const plot = Plot.plot({
      title: `Répartition de la population départementale (${selectedYear})`,
      subtitle: `Filtres actifs : Sexe = ${selectedSex} • Âge = ${selectedAge}`,
      caption: `Figure GeoJSON. Projection Mercator de France métropolitaine (${popMap.size} départements).`,
      ariaLabel: `Carte choroplèthe de la population de France en ${selectedYear} pour ${selectedSex}, tranche ${selectedAge}`,
      width: 750,
      height: 600,
      projection: {
        type: "mercator",
        domain: departements
      },
      color: {
        type: "quantile",
        n: 7,
        scheme: "Blues",
        label: "Population (habitants)",
        legend: true
      },
      marks: [
        Plot.geo(departements, {
          fill: (d: any) => popMap.get(d.properties.code) || 0,
          stroke: "#ffffff",
          strokeWidth: 0.6,
          title: (d: any) => {
            const val = popMap.get(d.properties.code) || 0;
            return `${d.properties.nom} (${d.properties.code})\nPopulation : ${val.toLocaleString("fr-FR")} hab.`;
          }
        })
      ]
    });

    // Remplacement du contenu dans le DOM
    chartContainer.innerHTML = "";
    chartContainer.appendChild(plot);
  }

  // Écouteurs sur les 3 SELECT demandés
  elmYear?.addEventListener("change", updatePlot);
  elmSex?.addEventListener("change", updatePlot);
  elmAge?.addEventListener("change", updatePlot);

  // Premier rendu automatique
  updatePlot();
</script>

