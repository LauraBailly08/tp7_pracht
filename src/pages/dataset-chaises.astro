---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Chaises de Bureau • TP4">
  <div class="space-y-6 max-w-5xl mx-auto">
    <!-- En-tete de la page -->
    <div class="bg-white/80 backdrop-blur-sm border border-sky-100 p-6 rounded-2xl shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <div class="inline-block px-2.5 py-0.5 bg-sky-100/70 text-sky-800 text-xs font-semibold rounded-md mb-1 border border-sky-200">
          Dataset 1 • Mobilier
        </div>
        <h1 class="text-2xl font-bold text-slate-800">Chaises de Bureau</h1>
        <p class="text-xs sm:text-sm text-slate-500">
          Analyse interactive des modeles de chaises ergonomiques, gaming et de bureau.
        </p>
      </div>
      <div id="chairs-counter" class="badge badge-soft bg-pink-100 text-rose-800 border-pink-200 text-xs font-medium px-3 py-2">
        Chargement...
      </div>
    </div>

    <!-- Controles simples DaisyUI -->
    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="select-category" class="block text-xs font-semibold text-slate-600 mb-1.5">
            Filtrer par Categorie :
          </label>
          <select
            id="select-category"
            class="select select-bordered select-sm w-full bg-white border-sky-200 focus:border-rose-400 focus:outline-none rounded-xl"
          >
            <option value="">Toutes les categories</option>
            <option value="Ergonomique">Ergonomique</option>
            <option value="Gaming">Gaming</option>
            <option value="Standard">Standard</option>
            <option value="Direction">Direction</option>
            <option value="Design">Design</option>
          </select>
        </div>

        <div>
          <label for="select-material" class="block text-xs font-semibold text-slate-600 mb-1.5">
            Filtrer par Materiau :
          </label>
          <select
            id="select-material"
            class="select select-bordered select-sm w-full bg-white border-sky-200 focus:border-rose-400 focus:outline-none rounded-xl"
          >
            <option value="">Tous les materiaux</option>
            <option value="Mesh">Mesh (Maille)</option>
            <option value="Tissu">Tissu</option>
            <option value="Cuir">Cuir veritable</option>
            <option value="Similicuir">Similicuir</option>
            <option value="TPE">TPE</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Graphique : Prix vs Note -->
    <div class="card bg-white/90 border border-sky-100 shadow-xs rounded-2xl p-6 space-y-3">
      <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
        Prix (€) vs Note Utilisateur (/5)
      </h2>
      <div id="plot-chairs" class="flex justify-center p-3 bg-sky-50/40 rounded-xl overflow-x-auto min-h-[340px] items-center"></div>
    </div>
  </div>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import chairs from "../assets/chairs.json";

  const selectCat = document.querySelector("#select-category") as HTMLSelectElement;
  const selectMat = document.querySelector("#select-material") as HTMLSelectElement;
  const plotDiv = document.querySelector("#plot-chairs") as HTMLDivElement;
  const counterDiv = document.querySelector("#chairs-counter") as HTMLDivElement;

  function renderPlot() {
    const category = selectCat.value;
    const material = selectMat.value;

    const filtered = chairs.filter((c) => {
      if (category && c.category !== category) return false;
      if (material && c.material !== material) return false;
      return true;
    });

    if (counterDiv) {
      counterDiv.textContent = `${filtered.length} chaises affichees sur ${chairs.length}`;
    }

    if (plotDiv) {
      plotDiv.innerHTML = "";

      if (filtered.length === 0) {
        plotDiv.innerHTML = `<p class="text-sm text-slate-400">Aucun resultat trouve.</p>`;
        return;
      }

      const plot = Plot.plot({
        grid: true,
        color: {
          legend: true,
          scheme: "Observable10",
        },
        x: {
          label: "Prix (€) ->",
          domain: [100, 1800],
        },
        y: {
          label: "^ Note client (/5)",
          domain: [3.5, 5.0],
        },
        marks: [
          Plot.dot(filtered, {
            x: "price",
            y: "rating",
            stroke: "category",
            fill: "category",
            fillOpacity: 0.35,
            r: 7,
            tip: true,
          }),
        ],
      });

      plotDiv.append(plot);
    }
  }

  selectCat.addEventListener("change", renderPlot);
  selectMat.addEventListener("change", renderPlot);

  renderPlot();
</script>
